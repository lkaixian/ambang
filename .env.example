ILMU_API_KEY=
ILMU_MODEL=
TUNNEL_TOKEN=
# Redis password (required; the stack will not start without it). Letters and digits only, e.g. `openssl rand -hex 24`.
REDIS_PASS=
# Limits are per IP; raised for events because a whole venue shares one Wi-Fi IP via Cloudflare/NAT.
RATE_PER_MIN=20
FLOOD_PER_MIN=300
# Uncached AI calls per day for the whole site (hard spend ceiling; unchanged).
DAILY_CAP=3000
TRUST_PROXY=1
# Address nginx publishes 80/443 on. Leave unset when only the Cloudflare tunnel reaches nginx; set 0.0.0.0 only if the server is exposed directly with DNS pointing at it.
# BIND_IP=0.0.0.0
